{
  "manifest_version": 3,
  "name": "PaperLens",
  "description": "Open web and local PDFs in a modern viewer with markup, search, smooth zoom, and an AI assistant.",
  "version": "0.8.1",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "PaperLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; worker-src 'self'; object-src 'self'; connect-src http://* https://*; frame-src 'self' blob: data: http://* https://*;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "vendor/pdfjs/pdf.worker.mjs"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
